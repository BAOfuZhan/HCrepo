[Unit]
Description=Seat renewal missed-scan catch-up
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/Main_ChaoXingReserveSeat
EnvironmentFile=-/etc/seat-qianduan.env
ExecStart=/usr/bin/python3 /opt/Main_ChaoXingReserveSeat/server_store/renewal_scan.py --catch-up
